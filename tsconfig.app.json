{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": false,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "composite": true
  },
  "include": [
    "src",
    "src/components/NetworkMonitor.tsx",
    "src/components/NexusCore.tsx",
    "src/components/NexusTerminal.tsx",
    "src/components/PermissionsEditor.tsx",
    "src/components/Settings.tsx",
    "src/components/SystemMonitor.tsx",
    "src/components/ui/DataStream.tsx",
    "src/components/ui/GlowingText.tsx",
    "src/components/ui/HolographicPanel.tsx",
    "src/components/ui/tabs.tsx",
    "src/components/visualizations/CircuitBoard.tsx",
    "src/components/visualizations/ForceGraph.tsx",
    "src/components/visualizations/HexagonGrid.tsx",
    "src/components/visualizations/MetricFlows.tsx",
    "src/components/visualizations/NeuralNetwork.tsx",
    "src/components/visualizations/TreeView.tsx",
    "src/components/Visualizer.tsx",
    "src/components/Window.tsx",
    "src/components/windows/AgentWindow.tsx",
    "src/components/windows/ExecutorWindow.tsx",
    "src/components/windows/JohnnyWindow.tsx",
    "src/components/windows/ModuleWindow.tsx",
    "src/components/windows/SystemWindow.tsx",
    "src/components/Chat.tsx",
    "src/components/CodeGenerator.tsx",
    "src/components/ConfigPanel.tsx",
    "src/components/Console.tsx",
    "src/components/CreateAgentDialog.tsx",
    "src/components/Dashboard.tsx",
    "src/components/DatabasePanel.tsx",
    "src/components/Desktop.tsx",
    "src/components/FileDropzone.tsx",
    "src/components/FileUpload.tsx",
    "src/components/InstructionsEditor.tsx",
    "src/components/KnowledgeBaseEditor.tsx",
    "src/components/Layout.tsx",
    "src/components/MessageList.tsx",
    "src/components/ModuleExplorer.tsx"
  ]
}
